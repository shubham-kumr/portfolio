---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import Blog from "@components/Blog"
import { BLOG } from "@consts"

const posts = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())

const tags = posts.flatMap(post => post.data.tags)
  .reduce((acc, tag) => {
    if (!acc.some((t: string) => t.toLowerCase() === tag.toLowerCase())) {
      acc.push(tag)
    }
    return acc
  }, [] as string[])
  .sort((a: string, b: string) => a.localeCompare(b))
---

<PageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <div class="blog-page">
    <h1 class="blog-heading">{BLOG.TITLE}</h1>
    <p class="blog-subtitle">{BLOG.DESCRIPTION}</p>

    <Blog client:load tags={tags} data={posts} />
  </div>
</PageLayout>

<style>
  .blog-page {
    max-width: 640px;
    margin: 0 auto;
    padding: 48px 24px 64px;
  }

  .blog-heading {
    font-size: 1.25rem;
    font-weight: 600;
    color: rgb(var(--brand-text));
    margin: 0 0 8px;
  }

  .blog-subtitle {
    font-size: 0.875rem;
    color: rgb(var(--brand-text) / 0.5);
    margin: 0 0 24px;
  }

  @media (max-width: 1024px) {
    .blog-page {
      padding: 48px 20px 56px;
    }
  }

  @media (max-width: 768px) {
    .blog-page {
      padding: 24px 20px 48px;
      max-width: 100%;
    }

    .blog-heading {
      font-size: 1.125rem;
    }
  }

  @media (max-width: 480px) {
    .blog-page {
      padding: 16px 16px 40px;
    }

    .blog-heading {
      font-size: 1rem;
    }

    .blog-subtitle {
      font-size: 0.75rem;
    }
  }
</style>
